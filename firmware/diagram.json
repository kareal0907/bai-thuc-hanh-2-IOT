{
  "version": 1,
  "author": "Bai 2 - IoT",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-dht22", "id": "dht", "top": -90, "left": 290, "attrs": { "temperature": "25", "humidity": "50" } },
    { "type": "wokwi-photoresistor-sensor", "id": "ldr", "top": 40, "left": -250, "attrs": { "lux": "500" } },
    { "type": "wokwi-hc-sr04", "id": "ultra", "top": 140, "left": 270, "attrs": { "distance": "100" } },
    { "type": "wokwi-led", "id": "led", "top": 260, "left": 75, "attrs": { "color": "green", "label": "MQTT TX" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 210, "left": 70, "rotate": 90, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp:RX0", "$serialMonitor:TX", "", [] ],
    [ "dht:VCC", "esp:3V3", "red", [] ],
    [ "dht:GND", "esp:GND.1", "black", [] ],
    [ "dht:SDA", "esp:D15", "green", [] ],
    [ "ldr:VCC", "esp:3V3", "red", [] ],
    [ "ldr:GND", "esp:GND.1", "black", [] ],
    [ "ldr:AO", "esp:D34", "purple", [] ],
    [ "ultra:VCC", "esp:VIN", "red", [] ],
    [ "ultra:GND", "esp:GND.2", "black", [] ],
    [ "ultra:TRIG", "esp:D5", "blue", [] ],
    [ "ultra:ECHO", "esp:D18", "orange", [] ],
    [ "esp:D2", "r1:1", "green", [] ],
    [ "r1:2", "led:A", "green", [] ],
    [ "led:C", "esp:GND.2", "black", [] ]
  ],
  "serialMonitor": { "display": "always", "newline": "lf" },
  "dependencies": {}
}
